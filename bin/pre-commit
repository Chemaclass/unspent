#!/usr/bin/env bash
#
# Pre-commit hook: runs `composer check:quick` (CS-Fixer + PHPUnit, ~3s).
# Rector and PHPStan run in CI; run `composer test` locally for the full gate.
#
# Skips when every staged file is non-PHP (docs, CI config). Prints tool
# output only when a check fails.
#
# Install: composer install (symlinks this into .git/hooks/pre-commit)
# Run manually: bin/pre-commit
# Bypass: git commit --no-verify

set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
PROJECT_ROOT="$(dirname "$(cd "$(dirname "$SCRIPT_PATH")" && pwd)")"
cd "$PROJECT_ROOT"

echo "Running pre-commit checks..."

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
if [[ -n "$staged" ]] && ! grep -qE '\.php$|^composer\.(json|lock)$|^phpunit\.xml|^\.php-cs-fixer' <<< "$staged"; then
    echo "No PHP changes staged, skipping checks."
    exit 0
fi

log="$(mktemp)"
trap 'rm -f "$log"' EXIT
start=$SECONDS

if ! composer check:quick > "$log" 2>&1; then
    cat "$log"
    echo ""
    echo "Pre-commit checks failed. Fix the issues above, or bypass with: git commit --no-verify"
    exit 1
fi

echo "Pre-commit checks passed ($((SECONDS - start))s). Full gate before pushing: composer test"
